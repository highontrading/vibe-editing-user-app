# ---- Core ----
NODE_ENV=development
APP_URL=http://localhost:3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vibe
AUTH_SECRET=change-me-generate-with-openssl-rand-base64-32
DATA_DIR=./data                     # local storage + scratch when no S3 configured

# ---- Auth providers (optional; email+password always works) ----
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ---- Queue (optional; without it jobs run inline in the web process) ----
REDIS_URL=

# ---- Object storage (optional; without it files live in DATA_DIR) ----
S3_ENDPOINT=                        # e.g. https://<account>.r2.cloudflarestorage.com or Railway bucket endpoint
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=                      # optional public/CDN base URL for the bucket

# ---- AI (optional; without keys the app runs in mock mode) ----
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-opus-5-5
AGENT_FAST_MODEL=claude-haiku-5-5
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
PEXELS_API_KEY=
PIXABAY_API_KEY=

# ---- Billing (optional) ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_CREATOR=
STRIPE_PRICE_PRO=
STRIPE_PRICE_STUDIO=

# ---- Worker ----
WORKER_CONCURRENCY=2
RENDER_CONCURRENCY=1
