# Web app (Next.js) for Railway. Also able to run jobs inline when REDIS_URL is unset,
# so ffmpeg + chromium are included.
FROM node:22-bookworm-slim AS base
ENV PNPM_HOME=/pnpm PATH=/pnpm:$PATH
RUN corepack enable && corepack prepare pnpm@10.28.0 --activate
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg chromium fonts-liberation fonts-noto-color-emoji ca-certificates openssl \
    libnss3 libatk1.0-0 libatk-bridge2.0-0 libcups2 libdrm2 libxkbcommon0 libxcomposite1 \
    libxdamage1 libxfixes3 libxrandr2 libgbm1 libasound2 libpango-1.0-0 libcairo2 \
  && rm -rf /var/lib/apt/lists/*
ENV REMOTION_BROWSER_EXECUTABLE=/usr/bin/chromium
WORKDIR /app

FROM base AS deps
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY apps/web/package.json apps/web/
COPY apps/worker/package.json apps/worker/
COPY packages/edl/package.json packages/edl/
COPY packages/db/package.json packages/db/
COPY packages/core/package.json packages/core/
COPY packages/media/package.json packages/media/
COPY packages/compositions/package.json packages/compositions/
COPY packages/agent/package.json packages/agent/
COPY packages/pipeline/package.json packages/pipeline/
RUN pnpm install --frozen-lockfile

FROM deps AS build
COPY . .
RUN pnpm --filter @vibe/db generate && pnpm --filter @vibe/web build

FROM build AS runner
ENV NODE_ENV=production
ENV PORT=3000
EXPOSE 3000
# Apply migrations (db push is used until migrations are generated), then start.
CMD ["sh", "-c", "pnpm --filter @vibe/db exec prisma db push --skip-generate --accept-data-loss && pnpm --filter @vibe/db seed; pnpm --filter @vibe/web start"]
