generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// ---------- Auth (Auth.js) ----------
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  plan               Plan      @default(FREE)
  stripeCustomerId   String?   @unique
  stripeSubscriptionId String? @unique
  planRenewsAt       DateTime?
  /// Minutes of export included per month for the plan
  minutesQuota       Int       @default(10)
  /// Minutes used in the current cycle
  minutesUsed        Float     @default(0)
  cycleStartedAt     DateTime  @default(now())
  preferences        Json      @default("{}")
  onboarded          Boolean   @default(false)

  accounts  Account[]
  sessions  Session[]
  projects  Project[]
  assets    Asset[]
  brandKit  BrandKit?
  recipes   Recipe[]
  ledger    CreditLedger[]
  jobs      Job[]
}

enum Plan {
  FREE
  CREATOR
  PRO
  STUDIO
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  @@unique([identifier, token])
}

/// ---------- Media ----------
enum AssetKind {
  VIDEO
  AUDIO
  IMAGE
}

enum AssetStatus {
  UPLOADING
  UPLOADED
  PROCESSING
  READY
  FAILED
}

enum AssetSource {
  UPLOAD
  STOCK
  GENERATED
  BRAND
  LIBRARY
  RENDER
}

model Asset {
  id          String      @id @default(cuid())
  userId      String
  projectId   String?
  kind        AssetKind
  source      AssetSource @default(UPLOAD)
  name        String
  mime        String
  sizeBytes   BigInt      @default(0)
  storageKey  String
  /// Derived files
  proxyKey    String?
  thumbKey    String?
  waveformKey String?
  audioKey    String?
  durationMs  Int?
  width       Int?
  height      Int?
  fps         Float?
  status      AssetStatus @default(UPLOADING)
  error       String?
  /// AssetAnalysis JSON from @vibe/edl
  analysis    Json?
  analysisStep String?
  attribution String?
  tags        String[]    @default([])
  folder      String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  @@index([userId, createdAt])
  @@index([projectId])
}

/// ---------- Projects ----------
enum ProjectStatus {
  DRAFTING
  ANALYZING
  PLANNING
  PLAN_READY
  BUILDING
  READY
  EXPORTING
  FAILED
}

model Project {
  id              String        @id @default(cuid())
  userId          String
  title           String
  status          ProjectStatus @default(DRAFTING)
  statusMessage   String?
  brief           String?
  aspect          String        @default("9:16")
  platform        String        @default("tiktok")
  targetDurationMs Int?
  recipeId        String?
  referenceAssetId String?
  /// Plan JSON from @vibe/edl
  plan            Json?
  currentVersionId String?      @unique
  thumbKey        String?
  archived        Boolean       @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  assets   Asset[]
  versions ScriptVersion[] @relation("ProjectVersions")
  current  ScriptVersion?  @relation("CurrentVersion", fields: [currentVersionId], references: [id])
  messages Message[]
  jobs     Job[]
  exports  Export[]
  recipe   Recipe?         @relation(fields: [recipeId], references: [id], onDelete: SetNull)
  @@index([userId, updatedAt])
}

enum VersionSource {
  RECIPE
  AGENT
  USER
  IMPORT
}

model ScriptVersion {
  id        String        @id @default(cuid())
  projectId String
  parentId  String?
  source    VersionSource @default(AGENT)
  /// EditScript JSON
  script    Json
  summary   String
  /// What caused it (user instruction / op label)
  label     String?
  createdAt DateTime      @default(now())

  project  Project  @relation("ProjectVersions", fields: [projectId], references: [id], onDelete: Cascade)
  currentOf Project? @relation("CurrentVersion")
  messages Message[]
  @@index([projectId, createdAt])
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

model Message {
  id        String      @id @default(cuid())
  projectId String
  role      MessageRole
  content   String
  /// Structured extras: ops applied, suggestions, checks, plan
  data      Json?
  versionId String?
  status    String      @default("done")
  createdAt DateTime    @default(now())
  project Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  version ScriptVersion? @relation(fields: [versionId], references: [id], onDelete: SetNull)
  @@index([projectId, createdAt])
}

/// ---------- Jobs ----------
enum JobStatus {
  QUEUED
  RUNNING
  DONE
  FAILED
  CANCELLED
}

model Job {
  id        String    @id @default(cuid())
  userId    String?
  projectId String?
  assetId   String?
  type      String
  status    JobStatus @default(QUEUED)
  progress  Int       @default(0)
  message   String?
  error     String?
  payload   Json      @default("{}")
  result    Json?
  attempts  Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  startedAt DateTime?
  finishedAt DateTime?
  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  @@index([projectId, createdAt])
  @@index([status, createdAt])
}

/// ---------- Exports ----------
model Export {
  id         String    @id @default(cuid())
  projectId  String
  versionId  String
  preset     String
  width      Int
  height     Int
  fps        Int       @default(30)
  burnCaptions Boolean @default(true)
  quality    String    @default("1080p")
  status     JobStatus @default(QUEUED)
  jobId      String?
  storageKey String?
  thumbKey   String?
  srtKey     String?
  sizeBytes  BigInt?
  durationMs Int?
  watermark  Boolean   @default(false)
  shareToken String?   @unique
  createdAt  DateTime  @default(now())
  finishedAt DateTime?
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  @@index([projectId, createdAt])
}

/// ---------- Recipes ----------
model Recipe {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  category    String
  description String
  /// What footage to bring
  bring       String
  sizes       String[] @default(["9:16"])
  /// Natural-language instructions the agent follows
  prompt      String
  /// Default plan settings (captionStyle, musicMood, colorPreset, targetDurationMs, steps...)
  defaults    Json     @default("{}")
  previewKey  String?
  previewUrl  String?
  tags        String[] @default([])
  usesGenerative Boolean @default(false)
  isPublic    Boolean  @default(true)
  isFeatured  Boolean  @default(false)
  ownerId     String?
  usageCount  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  owner    User?     @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  projects Project[]
  @@index([category])
}

/// ---------- Brand kit ----------
model BrandKit {
  id         String   @id @default(cuid())
  userId     String   @unique
  name       String   @default("My brand")
  logoAssetId String?
  introAssetId String?
  outroAssetId String?
  handle     String?
  fonts      String[] @default([])
  colors     String[] @default([])
  defaultCaptionStyle String?
  defaultMusicMood    String?
  voice      String?
  updatedAt  DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// ---------- Billing ----------
model CreditLedger {
  id        String   @id @default(cuid())
  userId    String
  /// minutes (+ grant / - usage)
  minutes   Float
  reason    String
  ref       String?
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, createdAt])
}

model StripeEvent {
  id        String   @id
  type      String
  createdAt DateTime @default(now())
}
